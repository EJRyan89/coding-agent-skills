{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-agent-skills/review-record.schema.json",
  "title": "Code-review record",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "pull_request",
    "review",
    "findings",
    "prior_dispositions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": { "type": "string" },
    "pull_request": {
      "type": "object",
      "required": ["number", "url", "title", "base_ref", "base_sha", "head_sha"],
      "properties": {
        "head_ref": { "description": "The pull request's head branch; absent from older records.", "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "required": ["version", "mode", "reviewed_at", "summary", "verdict", "counts", "adapter"],
      "properties": {
        "reviewers": {
          "description": "The reviewers that ran: files covered, findings raised, reruns, and time taken.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "files", "findings", "retries", "dispositions_only"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "minLength": 1 },
              "files": { "type": "integer", "minimum": 0 },
              "findings": { "type": "integer", "minimum": 0 },
              "retries": { "type": "integer", "minimum": 0 },
              "dispositions_only": { "type": "boolean" },
              "model": {
                "description": "The model the reviewer reported running on, from its accepted result; absent for a repository entrypoint reviewer and in older records.",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "seconds": {
                "description": "Whole seconds from handing the role to a reviewer to its accepted result, reruns included; absent when the run was not timed.",
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "patches": {
          "description": "Each changed file's patch fingerprint, built from its added and removed lines only, so the next re-review can tell which files changed since; absent in older records.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "lines"],
            "properties": {
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "lines": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "scope": {
          "description": "A re-review's scope: what was requested, what ran and why, and how much changed since the version it compared with. The changed counts are null when it could not compare.",
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "used", "reason", "since_version", "files_changed", "files_total", "lines_changed",
                       "lines_total"],
          "properties": {
            "requested": { "enum": ["auto", "full", "incremental"] },
            "used": { "enum": ["full", "incremental"] },
            "reason": { "type": "string", "minLength": 1 },
            "since_version": { "type": "integer", "minimum": 1 },
            "files_changed": { "type": ["integer", "null"], "minimum": 0 },
            "files_total": { "type": "integer", "minimum": 0 },
            "lines_changed": { "type": ["integer", "null"], "minimum": 0 },
            "lines_total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "findings": { "type": "array" },
    "prior_dispositions": { "type": "array" },
    "github_comments": {
      "description": "The open review comments the reviewers gave dispositions for, as listed in the request.",
      "type": "array",
      "minItems": 1
    },
    "comment_dispositions": { "type": "array" },
    "artifacts": {
      "type": "object",
      "required": ["payload_sha256", "markdown_sha256"]
    }
  },
  "dependentRequired": {
    "github_comments": ["comment_dispositions"],
    "comment_dispositions": ["github_comments"]
  }
}
