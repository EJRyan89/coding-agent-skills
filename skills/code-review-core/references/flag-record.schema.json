{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-agent-skills/flag-record.schema.json",
  "title": "Code-review flag store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "next_id", "flags"],
  "properties": {
    "schema_version": { "const": 2 },
    "next_id": { "type": "integer", "minimum": 1 },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "created_at",
          "resolved_at",
          "repository",
          "pull_number",
          "review_version",
          "finding_id",
          "category",
          "body",
          "resolution"
        ]
      }
    }
  }
}
