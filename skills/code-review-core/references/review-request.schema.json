{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-agent-skills/code-review-request.schema.json",
  "title": "Code review adapter request",
  "type": "object",
  "required": ["protocol_version", "mode", "repository", "pull_number", "pull_request", "diff_path", "source_snapshot", "prior_findings", "github_comments"],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "mode": { "type": "string", "enum": ["initial", "re-review"] },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "pull_number": { "type": "integer", "minimum": 1 },
    "pull_request": { "type": "object" },
    "diff_path": { "type": "string" },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "manifest_path", "source_commit"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      }
    },
    "prior_findings": { "type": "array" },
    "github_comments": {
      "description": "Unresolved review threads a person started (first comment only). Each needs a disposition.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "author", "path", "line", "outdated", "body", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[1-9][0-9]*$" },
          "author": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "outdated": { "type": "boolean" },
          "body": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unavailable_sources"],
      "properties": {
        "unavailable_sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  },
  "additionalProperties": false
}
