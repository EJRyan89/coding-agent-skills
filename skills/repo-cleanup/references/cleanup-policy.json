{
  "schema_version": 1,
  "protected_prefixes": ["release/"],
  "regenerable": [
    {"directory": "__pycache__", "projects": []},
    {"directory": ".pytest_cache", "projects": []},
    {"directory": ".mypy_cache", "projects": []},
    {"directory": ".ruff_cache", "projects": []},
    {"directory": "node_modules/.cache", "projects": []},
    {"directory": ".vs", "projects": []},
