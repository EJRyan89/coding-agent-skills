{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"$CLAUDE_PROJECT_DIR/tools/worktrees.py\" guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
