{
  "schema_version": 2,
  "id": "review-repository",
  "protocol_version": 1,
  "kind": "specialists",
  "supports": ["initial", "re-review"],
  "required_capabilities": ["read-diff", "write-result"],
  "resources": [
    "docs/design.md",
    "docs/adding-a-skill.md",
    ".claude/skills/review-repository/scripts/conditions.py",
    "skills/ejryan89-skill-core/scripts/atomic_file.py",
    "skills/ejryan89-skill-core/scripts/console.py",
    "skills/ejryan89-skill-core/scripts/device_names.py",
    "skills/ejryan89-skill-core/scripts/diff_paths.py",
    "skills/ejryan89-skill-core/scripts/file_presence.py",
    "skills/ejryan89-skill-core/scripts/flat_text.py",
    "skills/ejryan89-skill-core/scripts/json_reader.py",
    "skills/ejryan89-skill-core/scripts/json_writer.py",
    "skills/ejryan89-skill-core/scripts/link_probe.py",
    "skills/ejryan89-skill-core/scripts/markdown_sections.py",
    "skills/ejryan89-skill-core/scripts/nesting_depth.py",
    "skills/ejryan89-skill-core/scripts/ordinal_case.py",
    "skills/ejryan89-skill-core/scripts/path_containment.py",
    "skills/ejryan89-skill-core/scripts/path_keys.py",
    "skills/ejryan89-skill-core/scripts/python_reader.py",
    "skills/ejryan89-skill-core/scripts/suite_names.py",
    "skills/ejryan89-skill-core/scripts/whole_number.py"
  ],
  "finding_categories": [
    "Correctness",
    "Code-document drift",
    "Documents disagree",
    "Count or date in prose",
    "Unheld invariant",
    "Grant mismatch",
    "Missing upgrade note",
    "Misstated upgrade note",
    "Unstated trust boundary",
    "Test coverage",
    "Missed sibling",
    "Other"
  ],
  "fallback_finding_category": "Other",
  "specialists": [
    {
      "id": "deployer",
      "category": "Deployer",
      "profile": ".claude/skills/review-repository/references/deployer.md",
      "include": ["(?i)^deployer/", "(?i)^deploy\\.py$"],
      "exclude": [],
      "resources": [],
      "when": null
    },
    {
      "id": "skill-contract",
      "category": "Skill contract",
      "profile": ".claude/skills/review-repository/references/skill-contract.md",
      "include": [
        "(?i)^skills/[^/]+/SKILL\\.md$",
        "(?i)^agents/",
        "(?i)^deploy-meta/",
        "(?i)^source\\.json$",
        "(?i)^\\.claude/skills/[^/]+/SKILL\\.md$",
        "(?i)^\\.agents/skills/"
      ],
      "exclude": [],
      "resources": [],
      "when": null
    },
    {
      "id": "skill-scripts",
      "category": "Skill contract",
      "profile": ".claude/skills/review-repository/references/skill-contract.md",
      "include": ["(?i)^skills/[^/]+/scripts/", "(?i)^\\.claude/skills/[^/]+/scripts/"],
      "exclude": ["(?i)/(?:test_[^/]*|test-[^/]*|[^/]*_test(?:\\.[^/]*)?|[^/]*-test(?:\\.[^/]*)?|[^/]*\\.test\\.[^/]*)$"],
      "resources": [],
      "when": null,
      "shares_files": true
    },
    {
      "id": "validation-policy",
      "category": "Validation",
      "profile": ".claude/skills/review-repository/references/validation-policy.md",
      "include": [
        "(?i)^tests/validation/",
        "(?i)^tests/run_validation\\.py$",
        "(?i)^conftest\\.py$",
        "(?i)^pyproject\\.toml$"
      ],
      "exclude": [],
      "resources": ["CLAUDE.md"],
      "when": null
    },
    {
      "id": "trust-boundary",
      "category": "Trust boundary",
      "profile": ".claude/skills/review-repository/references/trust-boundary.md",
      "include": [
        "(?i)^docs/code-review-operations-contract\\.md$",
        "(?i)^agents/code-review-reviewer\\.md$",
        "(?i)^skills/ejryan89-code-review-core/references/[^/]+-reviewer\\.md$",
        "(?i)^tools/plugin_agents\\.py$",
        "(?i)^tools/(?:bash_syntax|checkout_trust|hub_guard|plugin_canary|runtime_canary|skill_evals|worktrees)\\.py$",
        "(?i)^tools/hub_guard-powershell\\.ps1$",
        "(?i)^\\.claude/settings\\.json$",
        "(?i)^deployer/platform_support\\.py$",
        "(?i)^tests/tools/test_(?:bash_syntax|checkout_trust|hub_guard|hub_guard_bash|hub_guard_git_options|hub_guard_pwsh|plugin_canary|prefix_programs|runtime_canary|skill_evals)\\.py$",
        "(?i)^tests/fixtures/hub-guard/",
        "(?i)^\\.claude/skills/shepherd-pull-requests/scripts/(?:test_)?shepherd_pull_requests\\.py$",
        "(?i)^skills/ejryan89-code-review-core/scripts/review_(?:analyzers|batches|canary|dispatch|documents|github|guard|hosts|io|operation|pipeline|process|records|reporting|reviewer_setup|reviewers|run|runtime|snapshot|source|specialists|vocabularies)\\.py$",
        "(?i)^skills/ejryan89-code-review-core/scripts/test_(?:adversarial_inputs|review_documents|review_guard)\\.py$",
        "(?i)^skills/ejryan89-skill-core/scripts/test_private_folder\\.py$",
        "(?i)^skills/review-document/scripts/review_document\\.py$",
        "(?i)^skills/review-insights/scripts/review_(?:guidance|insights|signals|synthesis)\\.py$",
        "(?i)^skills/(?:audit-ai-config|dotnet-dependencies)/scripts/",
        "(?i)^skills/ejryan89-skill-core/scripts/(?:analyzer_config|bounded_process|device_names|diff_paths|dotnet_solution|executable_locator|file_lock|file_presence|flat_text|folders_up|gh_shorthands|git_client|git_worktrees|github_client|github_remote|hook_decision|job_tree|json_reader|json_writer|link_probe|markdown_literal|module_assignments|msbuild_xml|nesting_depth|option_reader|ordinal_case|path_containment|path_keys|pdf_tool|private_folder|process_identity|python_reader|skill_menu|typed_fields|versions|whole_number|xml_reader)\\.py$"
      ],
      "exclude": [],
      "resources": ["docs/code-review-operations-contract.md", "docs/parallel-sessions.md"],
      "when": null
    },
    {
      "id": "documentation",
      "category": "Documentation",
      "profile": ".claude/skills/review-repository/references/documentation.md",
      "include": [
        "(?i)^docs/.+\\.md$",
        "(?i)^[^/]+\\.md$",
        "(?i)^\\.github/pull_request_template\\.md$",
        "(?i)^\\.github/ISSUE_TEMPLATE/"
      ],
      "exclude": [],
      "resources": ["docs/implementing-changes.md"],
      "when": null
    },
    {
      "id": "documentation-drift",
      "category": "Documentation",
      "profile": ".claude/skills/review-repository/references/documentation-drift.md",
      "include": ["(?i)\\.(?:py|ps1|sh)$"],
      "exclude": [],
      "resources": [],
      "when": "doc-passages",
      "shares_files": true
    },
    {
      "id": "untested-changes",
      "category": "Test coverage",
      "profile": ".claude/skills/review-repository/references/untested-changes.md",
      "include": ["(?i)\\.(?:py|ps1|sh)$"],
      "exclude": [],
      "resources": ["docs/implementing-changes.md"],
      "when": "untested-functions",
      "shares_files": true
    },
    {
      "id": "sibling-search",
      "category": "Sibling search",
      "profile": ".claude/skills/review-repository/references/sibling-search.md",
      "include": ["(?i)\\.(?:py|ps1|sh)$"],
      "exclude": [],
      "resources": ["docs/implementing-changes.md"],
      "when": null,
      "shares_files": true
    },
    {
      "id": "sibling-spellings",
      "category": "Sibling spellings",
      "profile": ".claude/skills/review-repository/references/sibling-spellings.md",
      "include": [
        "(?i)^docs/code-review-operations-contract\\.md$",
        "(?i)^agents/code-review-reviewer\\.md$",
        "(?i)^skills/ejryan89-code-review-core/references/[^/]+-reviewer\\.md$",
        "(?i)^tools/plugin_agents\\.py$",
        "(?i)^tools/(?:bash_syntax|checkout_trust|hub_guard|plugin_canary|runtime_canary|skill_evals|worktrees)\\.py$",
        "(?i)^tools/hub_guard-powershell\\.ps1$",
        "(?i)^\\.claude/settings\\.json$",
        "(?i)^deployer/platform_support\\.py$",
        "(?i)^tests/tools/test_(?:bash_syntax|checkout_trust|hub_guard|hub_guard_bash|hub_guard_git_options|hub_guard_pwsh|plugin_canary|prefix_programs|runtime_canary|skill_evals)\\.py$",
        "(?i)^tests/fixtures/hub-guard/",
        "(?i)^\\.claude/skills/shepherd-pull-requests/scripts/(?:test_)?shepherd_pull_requests\\.py$",
        "(?i)^skills/ejryan89-code-review-core/scripts/review_(?:analyzers|batches|canary|dispatch|documents|github|guard|hosts|io|operation|pipeline|process|records|reporting|reviewer_setup|reviewers|run|runtime|snapshot|source|specialists|vocabularies)\\.py$",
        "(?i)^skills/ejryan89-code-review-core/scripts/test_(?:adversarial_inputs|review_documents|review_guard)\\.py$",
        "(?i)^skills/ejryan89-skill-core/scripts/test_private_folder\\.py$",
        "(?i)^skills/review-document/scripts/review_document\\.py$",
        "(?i)^skills/review-insights/scripts/review_(?:guidance|insights|signals|synthesis)\\.py$",
        "(?i)^skills/(?:audit-ai-config|dotnet-dependencies)/scripts/",
        "(?i)^skills/ejryan89-skill-core/scripts/(?:analyzer_config|bounded_process|device_names|diff_paths|dotnet_solution|executable_locator|file_lock|file_presence|flat_text|folders_up|gh_shorthands|git_client|git_worktrees|github_client|github_remote|hook_decision|job_tree|json_reader|json_writer|link_probe|markdown_literal|module_assignments|msbuild_xml|nesting_depth|option_reader|ordinal_case|path_containment|path_keys|pdf_tool|private_folder|process_identity|python_reader|skill_menu|typed_fields|versions|whole_number|xml_reader)\\.py$",
        "(?i)^tests/validation/",
        "(?i)^tests/run_validation\\.py$",
        "(?i)^conftest\\.py$",
        "(?i)^pyproject\\.toml$"
      ],
      "exclude": [],
      "resources": [
        "docs/lessons.md",
        "docs/code-review-operations-contract.md",
        "docs/parallel-sessions.md",
        "CLAUDE.md"
      ],
      "when": null,
      "shares_files": true,
      "title_types": ["fix"],
      "inputs": ["closing-issues"]
    },
    {
      "id": "upgrade-notes",
      "category": "Upgrade notes",
      "profile": ".claude/skills/review-repository/references/upgrade-notes.md",
      "include": [
        "(?i)^deployer/(?:manifest|tools|arguments)\\.py$",
        "(?i)^skills/ejryan89-skill-core/scripts/pdf_tool\\.py$",
        "(?i)^deploy-meta/[^/]+\\.json$",
        "(?i)^skills/ejryan89-code-review-core/references/[^/]+\\.schema\\.json$",
        "(?i)^docs/code-review-operations-contract\\.md$",
        "(?i)^skills/[^/]+/SKILL\\.md$"
      ],
      "exclude": [],
      "resources": ["docs/releasing.md"],
      "when": null
    }
  ],
  "conditions": {
    "doc-passages": {
      "script": ".claude/skills/review-repository/scripts/doc_passages.py",
      "reads": [
        "*.md",
        "docs/**/*.md",
        "agents/*.md",
        "skills/*/SKILL.md",
        "skills/*/references/**/*.md",
        ".claude/skills/*/SKILL.md",
        ".claude/skills/*/references/**/*.md"
      ]
    },
    "untested-functions": {
      "script": ".claude/skills/review-repository/scripts/untested_functions.py",
      "reads": [
        "tests/**/test_*",
        "tests/**/test-*",
        "tests/**/*_test.*",
        "tests/**/*-test.*",
        "tests/**/*.test.*",
        "skills/**/scripts/**/test_*",
        "skills/**/scripts/**/test-*",
        "skills/**/scripts/**/*_test.*",
        "skills/**/scripts/**/*-test.*",
        "skills/**/scripts/**/*.test.*",
        ".claude/skills/*/scripts/**/test_*",
        ".claude/skills/*/scripts/**/test-*",
        ".claude/skills/*/scripts/**/*_test.*",
        ".claude/skills/*/scripts/**/*-test.*",
        ".claude/skills/*/scripts/**/*.test.*"
      ]
    }
  }
}
