{
  "schema_version": 2,
  "id": "review-repository",
  "protocol_version": 1,
  "kind": "specialists",
  "supports": ["initial", "re-review"],
  "required_capabilities": ["read-diff", "write-result"],
  "resources": [
    "docs/design.md",
    "docs/adding-a-skill.md",
    "skills/skill-core/scripts/console.py",
    "skills/skill-core/scripts/flat_text.py"
  ],
  "finding_categories": [
    "Correctness",
    "Code-document drift",
    "Documents disagree",
    "Count or date in prose",
    "Unheld invariant",
    "Grant mismatch",
    "Missing upgrade note",
    "Misstated upgrade note",
    "Unstated trust boundary",
    "Test coverage",
    "Other"
  ],
  "fallback_finding_category": "Other",
  "specialists": [
    {
      "id": "deployer",
      "category": "Deployer",
      "profile": ".claude/skills/review-repository/references/deployer.md",
      "include": ["^deployer/", "^deploy\\.py$"],
      "exclude": [],
      "resources": [],
      "when": null
    },
    {
      "id": "skill-contract",
      "category": "Skill contract",
      "profile": ".claude/skills/review-repository/references/skill-contract.md",
      "include": [
        "^skills/(?:[^/]+/)?[^/]+/SKILL\\.md$",
        "^agents/",
        "^deploy-meta/",
        "^source\\.json$",
        "^\\.claude/skills/[^/]+/SKILL\\.md$",
        "^\\.agents/skills/"
      ],
      "exclude": [],
      "resources": [],
      "when": null
    },
    {
      "id": "validation-policy",
      "category": "Validation",
      "profile": ".claude/skills/review-repository/references/validation-policy.md",
      "include": ["^tests/validation/", "^tests/run_validation\\.py$", "^tests/run_shard\\.py$", "^pyproject\\.toml$"],
      "exclude": [],
      "resources": ["CLAUDE.md"],
      "when": null
    },
    {
      "id": "trust-boundary",
      "category": "Trust boundary",
      "profile": ".claude/skills/review-repository/references/trust-boundary.md",
      "include": [
        "^docs/code-review-operations-contract\\.md$",
        "^skills/code-review-core/scripts/review_(?:analyzers|documents|github|guard|hosts|pipeline|process|records|runtime|source|specialists)\\.py$",
        "^skills/code-review-core/scripts/test_adversarial_inputs\\.py$",
        "^skills/skill-core/scripts/(?:bounded_process|git_client|github_client|job_tree|pdf_tool|typed_fields)\\.py$"
      ],
      "exclude": [],
      "resources": ["docs/code-review-operations-contract.md"],
      "when": null
    },
    {
      "id": "documentation",
      "category": "Documentation",
      "profile": ".claude/skills/review-repository/references/documentation.md",
      "include": ["^docs/.+\\.md$", "^[^/]+\\.md$", "^\\.github/pull_request_template\\.md$", "^\\.github/ISSUE_TEMPLATE/"],
      "exclude": [],
      "resources": ["docs/implementing-changes.md"],
      "when": null
    },
    {
      "id": "documentation-drift",
      "category": "Documentation",
      "profile": ".claude/skills/review-repository/references/documentation-drift.md",
      "include": ["\\.(?:py|ps1|sh)$"],
      "exclude": [],
      "resources": [],
      "when": "doc-passages",
      "shares_files": true
    },
    {
      "id": "untested-changes",
      "category": "Test coverage",
      "profile": ".claude/skills/review-repository/references/untested-changes.md",
      "include": ["\\.(?:py|ps1|sh)$"],
      "exclude": [],
      "resources": [],
      "when": "untested-functions",
      "shares_files": true
    },
    {
      "id": "upgrade-notes",
      "category": "Upgrade notes",
      "profile": ".claude/skills/review-repository/references/upgrade-notes.md",
      "include": [
        "^deployer/(?:manifest|tools|arguments)\\.py$",
        "^skills/skill-core/scripts/pdf_tool\\.py$",
        "^deploy-meta/[^/]+\\.json$",
        "^skills/code-review-core/references/[^/]+\\.schema\\.json$",
        "^docs/code-review-operations-contract\\.md$",
        "^skills/(?:[^/]+/)?[^/]+/SKILL\\.md$"
      ],
      "exclude": [],
      "resources": ["docs/releasing.md"],
      "when": null
    }
  ],
  "conditions": {
    "doc-passages": {
      "script": ".claude/skills/review-repository/scripts/doc_passages.py",
      "reads": [
        "docs/**/*.md",
        "README.md",
        "CONTRIBUTING.md",
        "CLAUDE.md",
        "skills/**/SKILL.md",
        ".claude/skills/*/SKILL.md"
      ]
    },
    "untested-functions": {
      "script": ".claude/skills/review-repository/scripts/untested_functions.py",
      "reads": [
        "tests/**/test_*",
        "tests/**/test-*",
        "tests/**/*_test.*",
        "tests/**/*-test.*",
        "tests/**/*.test.*",
        "skills/**/scripts/**/test_*",
        "skills/**/scripts/**/test-*",
        "skills/**/scripts/**/*_test.*",
        "skills/**/scripts/**/*-test.*",
        "skills/**/scripts/**/*.test.*",
        ".claude/skills/*/scripts/**/test_*",
        ".claude/skills/*/scripts/**/test-*",
        ".claude/skills/*/scripts/**/*_test.*",
        ".claude/skills/*/scripts/**/*-test.*",
        ".claude/skills/*/scripts/**/*.test.*"
      ]
    }
  }
}
