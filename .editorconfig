root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Repository file formats.
[*.{json,yml,yaml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.py]
indent_size = 4

# Trailing spaces can represent intentional hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
